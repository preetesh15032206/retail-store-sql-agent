# ==============================================================================
# AI DATABASE AGENT / AI SQL ASSISTANT ENVIRONMENT CONFIGURATION
# ==============================================================================

# AI PROVIDER CONFIGURATION (Free-Tier Gemini Flash)
# GEMINI_API_KEY: Required for AI SQL generation, query explanation, and auto-correction.
# In Google AI Studio, this is automatically injected at runtime from Secrets.
# Obtain a free key at: https://aistudio.google.com/
GEMINI_API_KEY=""

# SERVER CONFIGURATION
PORT=3000
NODE_ENV="development"

# OPTIONAL EXTERNAL MYSQL DATABASE CREDENTIALS
# The application includes a built-in in-memory relational database seeded with
# customers, products, and orders data for zero-config immediate use.
# To connect to an external MySQL server, set these variables or use the in-app connection modal:
DB_HOST="localhost"
DB_PORT="3306"
DB_USER="read_only_user"
DB_PASSWORD=""
DB_NAME="retail_store"

# APP_URL: The URL where this applet is hosted.
# Automatically set in Cloud Run environments.
APP_URL="http://localhost:3000"

